cc_library_static {
    name: "libipcrenderbuffer_static",
    export_include_dirs: ["include"],
    static_libs: ["libskia"],
    shared_libs: ["libgui"],
    srcs: [
        "src/RenderBufferOps.cpp",
        "src/RenderBufferDebugUtils.cpp",
        "src/IPCRecordingCanvas.cpp",
        ":rendercommandbuffer_sources",
    ],
}

cc_binary {
    name: "replay_render_buffer",
    srcs: ["replay_render_buffer.cpp"], // Adjust path if needed
    static_libs: [
        "libipcrenderbuffer_static",
        "libskia",
    ],
    shared_libs: [
        "libandroid",
        "libgui",
        "libbinder",
        "libutils",
    ],
    defaults: ["skia_deps"],
    local_include_dirs: ["include"], // If your viewer app has local headers
}
