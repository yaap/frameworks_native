flag {
  name: "follower_arbitrary_refresh_rate_selection"
  namespace: "desktop_display"
  description: "Enables selection of any refresh rate for the follower display instead of one matching the pacesetter."
  bug: "371584290"
} # follower_arbitrary_refresh_rate_selection

flag {
  name: "follower_arbitrary_refresh_rate_selection_platform"
  namespace: "core_graphics"
  description: "Platform flag to enable selection of any refresh rate for the follower display instead of one matching the pacesetter."
  bug: "371584290"
} # follower_arbitrary_refresh_rate_selection_platform

flag {
  name: "follower_display_backpressure"
  namespace: "desktop_display"
  description: "Skips presentation on a follower display if there is a pending present for the next follower vsync. Enables follower displays to present even when their refresh rate does not match the pacesetter display."
  bug: "374072507"
} # follower_display_backpressure

flag {
  name: "follower_display_backpressure_platform"
  namespace: "core_graphics"
  description: "Platform flag to skips presentation on a follower display if there is a pending present for the next follower vsync. Enables follower displays to present even when their refresh rate does not match the pacesetter display."
  bug: "374072507"
} # follower_display_backpressure_platform

flag {
  name: "force_sdr_invalid_hdr_type"
  namespace: "core_graphics"
  description: "Allow OEMs to opt into receiving stronger signals about forced-SDR mode by sending forceHdrType=INVALID_HDR_TYPE into Composer HAL"
  bug: "419756717"
} # force_sdr_invalid_hdr_type

flag {
  name: "force_slower_follower_gpu_composition"
  namespace: "desktop_display"
  description: "Force slower connected displays to be GPU composited."
  bug: "389982803"
} # force_slower_follower_gpu_composition

flag {
  name: "force_slower_follower_gpu_composition_platform"
  namespace: "core_graphics"
  description: "Platform flag to force slower connected displays to be GPU composited."
  bug: "389982803"
} # force_slower_follower_gpu_composition_platform

flag {
  name: "force_compile_graphite_renderengine"
  namespace: "core_graphics"
  description: "Compile Skia's Graphite Vulkan backend in RenderEngine, but do NOT enable it, unless graphite_renderengine is also set. It can also be enabled with the debug.renderengine.graphite system property for testing. In contrast, the graphite_renderengine flag both compiles AND enables Graphite in RenderEngine."
  bug: "293371537"
  is_fixed_read_only: true
} # force_compile_graphite_renderengine

flag {
  name: "frame_rate_category_mrr"
  namespace: "core_graphics"
  description: "Enable to use frame rate category and newer frame rate votes such as GTE in SurfaceFlinger scheduler, to guard dVRR changes from MRR devices"
  bug: "330224639"
  is_fixed_read_only: true
  metadata {
    purpose: PURPOSE_BUGFIX
  }
} # frame_rate_category_mrr

flag {
  name: "frametimeline_boottime_in_lambda"
