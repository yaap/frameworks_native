package {
    default_team: "trendy_team_desktop_connectivity",
}

rust_defaults {
    name: "libusbauthservice_defaults",
    edition: "2021",
    rustlibs: [
        "android.hardware.usb.auth-rust",
        "libtempfile",
        "libthiserror",
        "libueventd",
        "liblog_rust",
        "liblogger",
        "libregex",
        "libtokio",
        "libtokio_stream",
        "libbinder_rs",
        "libclap",
    ],
}

rust_library {
    name: "libusbauthservice_core",
    crate_name: "usbauthservice_core",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["lib.rs"],
    host_supported: true,
}

rust_test_host {
    name: "libusbauthservice_core_test",
    crate_name: "usbauthservice_core",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["lib.rs"],
    rustlibs: [
        "libenv_logger",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
    compile_multilib: "both",
}

rust_binary {
    name: "usbauthservice",
    crate_name: "usbauthservice",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["usbauthservice.rs"],
    init_rc: ["usbauthservice.rc"],
    rustlibs: [
        "librustutils",
        "libusbauthservice_core",
        "libusb_flags_lib_rust",
    ],
    prefer_rlib: true,
}

rust_test {
    name: "usbauthservice_test",
    crate_name: "usbauthservice",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["usbauthservice.rs"],
    rustlibs: [
        "librustutils",
        "libusbauthservice_core",
        "libusb_flags_lib_rust",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
    compile_multilib: "first",
}

rust_binary {
    name: "usbauthservice_client",
    crate_name: "usbauthservice_client",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["utils/client.rs"],
    prefer_rlib: true,
}

rust_binary_host {
    name: "usbauthservice_validate_policy",
    crate_name: "usbauthservice_validate_policy",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["utils/validate_policy_file.rs"],
    rustlibs: [
        "libusbauthservice_core",
    ],
}

rust_test_host {
    name: "usbauthservice_validate_policy_test",
    crate_name: "usbauthservice_validate_policy",
    defaults: ["libusbauthservice_defaults"],
    srcs: ["utils/validate_policy_file.rs"],
    data: ["config/desktop_auth_policy.conf"],
    rustlibs: [
        "libusbauthservice_core",
        "libenv_logger",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

prebuilt_etc {
    name: "desktop_auth_policy",
    src: "config/desktop_auth_policy.conf",
    sub_dir: "usb_auth",
    filename: "policy.conf",
}

prebuilt_etc {
    name: "desktop_interactive_auth_policy",
    src: "config/desktop_interactive_auth_policy.conf",
    sub_dir: "usb_auth",
    filename: "interactive_policy.conf",
}
