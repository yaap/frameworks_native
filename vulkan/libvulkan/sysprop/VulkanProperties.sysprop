module: "android.sysprop.VulkanProperties"
owner: Platform

# These two properties are formatted as colon-separated lists, which
# is different the than StringList type (a comma-separated list)
prop {
    api_name: "platform_layers"
    type: String
    prop_name: "ro.vulkan.layers.platform"
    scope: Public
    access: Readonly
}
prop {
    api_name: "oem_layers"
    type: String
    prop_name: "ro.vulkan.layers.oem"
    scope: Public
    access: Readonly
}
